    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; Notices</string>
    <string name="privacy_summary">ModuleX Translator translates on your phone. Your voice, photos and text are processed locally and are not uploaded. Audio is kept in memory only while it is being recognized. Conversations in Offline mode never use the internet. In Internet mode, an encrypted connection carries translated text directly between the two phones; the connection server you configure only helps them find each other and can see network addresses and connection times, not your messages.</string>
    <string name="privacy_permissions">Permissions</string>
    <string name="privacy_permissions_body">Microphone: only while you speak to translate. Camera: only while the camera translator is open. Nearby devices and Bluetooth: only to connect to the other phone in a conversation. Notifications: to show that a conversation is active.</string>
    <string name="privacy_storage">Stored on this phone</string>
    <string name="privacy_storage_body">Language packs, your settings, a device key for secure pairing (in the Android Keystore), and translation history if you keep it on. Nothing is backed up to the cloud.</string>
    <string name="privacy_no_analytics">No analytics, no advertising, no tracking.</string>
    <string name="notices_title">Third-Party Notices</string>
    <string name="notices_intro">ModuleX Translator is built with the following open-source software and models. Their licenses are reproduced below.</string>

