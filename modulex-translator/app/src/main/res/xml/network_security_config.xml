<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext traffic is never allowed. Peer connections use TLS 1.3 with pinned device
     certificates (handled in code); downloads and signaling use HTTPS/WSS with system CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
