# ModuleX signaling relay configuration. Copy to `.env` and adjust; never commit real secrets.

# Plain HTTP/WebSocket listener (put a TLS-terminating reverse proxy in front of it).
HOST=0.0.0.0
PORT=8080

# Limits (defaults shown).
MAX_FRAME_BYTES=16384
MAX_ROOMS=10000
ROOM_IDLE_SECONDS=600
JOIN_RATE_PER_MINUTE=30
MSG_RATE_PER_10S=50

# Set to true ONLY when every request arrives through a reverse proxy you control that
# overwrites X-Forwarded-For; otherwise clients can spoof it to dodge the join rate limit.
TRUST_PROXY_HEADERS=false

# Optional built-in TLS listener (leave TLS_PORT unset to disable). PKCS12 or JKS keystore.
# TLS_PORT=8443
# TLS_KEYSTORE_PATH=/run/secrets/relay.p12
# TLS_KEYSTORE_PASSWORD=change-me
# TLS_KEY_ALIAS=relay
